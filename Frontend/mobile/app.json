{
  "expo": {
    "name": "RPM Patient",
    "slug": "rpm-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "notification": {
        "sound": "rpm_notification.wav"
      }
    },
    "android": {
      "package": "com.rpm.app",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "config": {
        "usesCleartextTraffic": true
      },
      "edgeToEdgeEnabled": true,
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#10B981"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "rpm",
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#10B981",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "./plugins/withCleartextTraffic",
      "./plugins/withNotificationSound",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "c5421d90-fe05-49d4-b6bd-4aafd80f294b"
      }
    }
  }
}
