{
  "expo": {
    "name": "RPM Doctor",
    "slug": "rpm-doctor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rpm.doctor"
    },
    "android": {
      "package": "com.rpm.doctor",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "config": {
        "usesCleartextTraffic": true
      }
    },
    "scheme": "rpm-doctor",
    "plugins": [
      "expo-dev-client",
      "./plugins/withCleartextTraffic",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
