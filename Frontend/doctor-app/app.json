{
  "expo": {
    "name": "RPM Staff",
    "slug": "rpm-doctor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rpm.doctor"
    },
    "android": {
      "package": "com.rpm.doctor",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2563EB"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "config": {
        "usesCleartextTraffic": true
      },
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#2563EB"
      }
    },
    "scheme": "rpm-doctor",
    "plugins": [
      "expo-dev-client",
      "./plugins/withCleartextTraffic",
      "./plugins/withNotificationSound",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "rpm_notification",
          "icon": "./assets/notification-icon.png"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "411163ca-e1c9-42c6-9392-bd87ffd1b5b1"
      }
    }
  }
}
