GIN_MODE=debug
PORT=8080
FE_WEB_URL=http://localhost:3000
FE_ADMIN_URL=http://localhost:3001
JWT_SECRET=mysecret
# AES-256 key for field encryption at rest:
# - users.phone
# - patients: CCCD, insurance, medicalHistory, emergency contact
# - staff: licenseNumber
# - chat messages: content
# Generate: openssl rand -base64 32
# Required for encrypted PHI and phone login/uniqueness lookup.
FIELD_ENCRYPTION_KEY=
MONGO_URI=mongodb+srv://...
MONGO_DB_NAME=rpm
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=youremail@example.com
SMTP_PASSWORD=yourpassword
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Trial/testing only: route every outbound SMS to this verified number.
TWILIO_TO_NUMBER_OVERRIDE=
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redispassword
REDIS_DB=0
# Cache-aside layer (reuses the Redis connection above)
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
