GIN_MODE=release
PORT=8080
FE_WEB_URL=https://your-production-domain.com
FE_ADMIN_URL=https://your-production-domain.com/admin
JWT_SECRET=your_strong_production_secret_here

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=rpm

# Google OAuth
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
GOOGLE_REDIRECT_URL=https://your-production-domain.com/auth/google/callback

# SMTP Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=youremail@gmail.com
SMTP_PASSWORD=yourapppassword

# Redis (overridden to redis:6379 in docker-compose.prod.yml)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redispassword
REDIS_DB=0

# Cache-aside layer (reuses the Redis connection above)
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300

# Temporal (overridden to temporal:7233 in docker-compose.prod.yml)
TEMPORAL_HOST=temporal:7233